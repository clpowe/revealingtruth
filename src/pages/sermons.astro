---
import { format } from "@formkit/tempo";
import BaseLayout from "../layouts/BaseLayout.astro";
import Tag from "../components/Tag.astro";
import Button from "../components/Button.astro";
import SermonPlayer from "../components/SermonPlayer.astro";
import WeekPanel from "../components/WeekPanel.astro";
import SermonArchive from "../components/SermonArchive.astro";
import { seo } from "../config/seo";
import { ClientRouter } from "astro:transitions";
import { env } from "cloudflare:workers";
import { getSermons } from "../config/sermons";
import {
  addDays,
  label,
  link,
  playLink,
  startOfWeek,
  today,
  validDate,
} from "../config/sermon-view";

export const prerender = false;

const sermons = await getSermons(env.LIVE_KV);
const params = Astro.url.searchParams;

const playing =
  sermons.find((sermon) => sermon.id === params.get("v")) ?? sermons[0];
const newer = playing && sermons[sermons.indexOf(playing) - 1];
const week = startOfWeek(validDate(params.get("week")) ?? playing?.date ?? today());
const weekSermons = sermons
  .filter((sermon) => startOfWeek(sermon.date) === week)
  .reverse();

const years = [...new Set(sermons.map((sermon) => sermon.date.slice(0, 4)))];
const year =
  years.find((y) => y === params.get("year")) ??
  playing?.date.slice(0, 4) ??
  today().slice(0, 4);

/* Title: names what the view shows beyond the default (latest sermon, its
   week and year), so tabs and history read apart and the ClientRouter,
   which announces the title after each swap, says what changed:
   "A Leap of Faith · Week of Nov 8, 2026 · Sermons" */
const title = [
  params.has("v") && playing?.title,
  params.has("week") &&
    week !== startOfWeek(playing?.date ?? week) &&
    `Week of ${format(week, "MMM D, YYYY")}`,
  params.has("year") && year !== playing?.date.slice(0, 4) && `${year} archive`,
  "Sermons",
]
  .filter(Boolean)
  .join(" · ");
---

<BaseLayout
  title={title}
  description="Watch every Sunday message and Wednesday night from Revealing Truth Church, week by week."
  position="static"
>
  {/* Sermon, week and year links swap the page in place instead of
      reloading it; without script they stay plain links */}
  <ClientRouter slot="head" />

  {/* Light by default; theater mode (the player's toggle) turns it dark */}
  <main data-theme="light" data-theater>
    {/* Before anything paints: a theater choice survives the reload every
        sermon and week link causes, without flashing light first */}
    <script is:inline>
      try {
        if (localStorage.getItem("theater") === "on") {
          document.currentScript.parentElement.dataset.theme = "dark";
        }
      } catch {}
    </script>
    <h1 class="visually-hidden">Sermons</h1>

    {/* Player + this week ------------------------------------------- */}
    <section class="section">
      <div
        class="wrapper equal-columns"
        data-ratio="2:1"
        data-align="start"
        data-expandable
      >
        {/* The player's wide toggle, reapplied before paint like theater */}
        <script is:inline>
          try {
            if (localStorage.getItem("player-wide") === "on") {
              document.currentScript.parentElement.setAttribute(
                "data-expanded",
                "",
              );
            }
          } catch {}
        </script>
        <div class="flow" style="--flow-space: var(--size-600);">
          {playing ? (
            <>
              <SermonPlayer
                id={playing.id}
                title={playing.title}
                next={newer && { href: playLink(params, newer), title: newer.title }}
              />
              <div class="repel" data-align="end">
                <div class="flow" style="--flow-space: var(--size-300);">
                  <Tag>{label(playing)}</Tag>
                  {/* Focusable by script only: picking a sermon lands here */}
                  <h2 class="sermon-title" tabindex="-1">
                    {playing.title}
                  </h2>
                  <p class="sermon-meta cluster">
                    {playing.speaker && <strong>{playing.speaker}</strong>}
                    <span>{format(playing.date, "dddd, MMM D, YYYY")}</span>
                    {playing.gathering && (
                      <span>{playing.gathering} gathering</span>
                    )}
                    <span>Streamed live</span>
                  </p>
                </div>
                <div class="cluster" style="--cluster-gap: var(--size-300);">
                  <Button
                    type="accent"
                    href={`https://www.youtube.com/watch?v=${playing.id}`}
                  >
                    Watch on YouTube ↗
                  </Button>
                  <Button
                    type="outline"
                    href={`${seo.social.youtube}?sub_confirmation=1`}
                  >
                    Subscribe
                  </Button>
                </div>
              </div>
            </>
          ) : (
            <p>Sermons are on their way. Check back soon.</p>
          )}
        </div>

        <WeekPanel
          heading={format(week, "MMM D, YYYY")}
          previous={link(params, { week: addDays(week, -7) })}
          next={link(params, { week: addDays(week, 7) })}
          items={weekSermons.map((sermon) => ({
            href: playLink(params, sermon),
            weekday: format(sermon.date, "ddd"),
            day: format(sermon.date, "D"),
            label: label(sermon),
            title: sermon.title,
            meta: [
              sermon.speaker,
              sermon.gathering && `${sermon.gathering} gathering`,
            ].filter((part): part is string => Boolean(part)),
            playing: sermon.id === playing?.id,
          }))}
        />
      </div>
    </section>

    <SermonArchive
      sermons={sermons}
      year={year}
      week={week}
      playingId={playing?.id}
    />
  </main>
</BaseLayout>

<script>
  /* In-place navigation ------------------------------------------------
     A link that keeps the same sermon (a week or year change) leaves the
     page where it was; one that picks a sermon goes up to the player */
  let keepScroll: { x: number; y: number } | undefined;

  /* Focus: the swap replaces every element, so focus would fall back to
     <body> and a keyboard user would start over from the top. A week or
     year link hands focus to the same control on the new page (found by
     its nav and name, "Weeks" + "Next week"); a sermon link to its title */
  let refocus: { nav: string | null; name: string } | "title" | undefined;

  const nameOf = (el: Element) =>
    (el.getAttribute("aria-label") ?? el.textContent ?? "").trim();

  function findControl({ nav, name }: { nav: string | null; name: string }) {
    const area = nav
      ? document.querySelector(`nav[aria-label="${CSS.escape(nav)}"]`)
      : document.querySelector("main");
    return [
      ...(area?.querySelectorAll<HTMLElement>("a[href], button") ?? []),
    ].find((el) => nameOf(el) === name);
  }

  document.addEventListener("astro:before-preparation", (event) => {
    const sameSermon =
      event.to.pathname === event.from.pathname &&
      event.to.searchParams.get("v") === event.from.searchParams.get("v");
    const push = event.navigationType === "push";
    keepScroll = push && sameSermon ? { x: scrollX, y: scrollY } : undefined;

    const source = event.sourceElement ?? document.activeElement;
    if (!push || !(source instanceof HTMLElement) || !source.closest("main"))
      refocus = undefined;
    else if (!sameSermon) refocus = "title";
    else
      refocus = {
        nav: source.closest("nav")?.getAttribute("aria-label") ?? null,
        name: nameOf(source),
      };
  });

  // Carry theater and wide over before the new page paints, so it never
  // flashes back to the defaults the inline scripts would fix a beat later
  document.addEventListener("astro:before-swap", (event) => {
    const theater = document.querySelector<HTMLElement>("[data-theater]");
    const nextTheater =
      event.newDocument.querySelector<HTMLElement>("[data-theater]");
    if (theater && nextTheater)
      nextTheater.dataset.theme = theater.dataset.theme;

    const wide = document
      .querySelector("[data-expandable]")
      ?.hasAttribute("data-expanded");
    event.newDocument
      .querySelector("[data-expandable]")
      ?.toggleAttribute("data-expanded", !!wide);
  });

  document.addEventListener("astro:after-swap", () => {
    if (keepScroll) scrollTo(keepScroll.x, keepScroll.y);
    keepScroll = undefined;

    const target =
      refocus === "title"
        ? document.querySelector<HTMLElement>(".sermon-title")
        : refocus && findControl(refocus);
    target?.focus({ preventScroll: true });
    refocus = undefined;
  });
</script>

<style>
  /* Theater mode fades the page rather than snapping */
  main[data-theater] {
    transition:
      background-color var(--duration-slow) var(--ease-smooth),
      color var(--duration-slow) var(--ease-smooth);
  }

  /* Wide player: one column, the week panel drops below */
  [data-expandable][data-expanded] {
    grid-template-columns: minmax(0, 1fr);
  }

  .sermon-title {
    font-family: var(--ff-heading);
    font-size: var(--fs-600);
    font-weight: var(--fw-semi-bold);
    line-height: var(--lh-heading);
    color: var(--text-high-contrast);
  }

  /* Script focus after picking a sermon: a heading isn't a control, so no ring */
  .sermon-title:focus {
    outline: none;
  }
</style>
