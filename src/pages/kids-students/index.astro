---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import Hero from "../../components/Hero.astro";
import Media from "../../components/Media.astro";
import familyImage from "../../assets/images/locations/family.webp";
import overviewPlaceholder from "../../assets/images/kids-students/overview-placeholder.webp";
import creativeKidsImage from "../../assets/images/kids-students/creative-kids-placeholder.webp";
import youngHeartsImage from "../../assets/images/kids-students/young-hearts-placeholder.webp";
import visionUImage from "../../assets/images/kids-students/vision-u-placeholder.webp";

const programs = [
  {
    name: "Creative Kids",
    ages: "6 weeks through 5th grade at RTC Tampa",
    href: "/kids-students/creative-kids",
    image: creativeKidsImage,
  },
  {
    name: "Young Hearts Big Dreams",
    ages: "Middle school",
    href: "/kids-students/students#young-hearts",
    image: youngHeartsImage,
  },
  {
    name: "Vision U",
    ages: "High school",
    href: "/kids-students/students#vision-u",
    image: visionUImage,
  },
];
---

<BaseLayout
  title="Kids & Students"
  description="From nursery through high school, find your place at Revealing Truth Church. Explore Creative Kids, Young Hearts Big Dreams, and Vision U."
  image={familyImage}
  imageAlt="A family at Revealing Truth Church"
>
  <main>
    <Hero image={overviewPlaceholder} alt="" size="compact">
      Kids &amp; <span class="font-accent text-brand">Students</span>
    </Hero>

    <section class="section" aria-label="Programs by age">
      <div class="wrapper flow overview">
        <div class="equal-columns" data-align="center">
          <div class="flow intro">
            <p>
              From the nursery through high school, we want kids and students to
              know how much Jesus loves them, grow in God’s Word, and find
              friends to grow with. Explore Creative Kids, Young Hearts Big
              Dreams, and Vision U to find the right place for your family.
            </p>
            <div class="cluster">
              <Button type="accent" href="/kids-students/creative-kids">
                Explore Creative Kids
              </Button>
              <Button type="outline" href="/kids-students/students">
                Explore RTC Students
              </Button>
            </div>
          </div>
          <Media
            src={familyImage}
            alt="A family at Revealing Truth Church"
            shape="rounded"
            sizes="(width > 720px) 50vw, 100vw"
          />
        </div>
        <ul class="equal-columns programs" data-align="start" role="list">
          {programs.map(({ name, ages, href, image }) => (
            <li>
              <a class="program-link flow" href={href}>
                <Media
                  src={image}
                  alt=""
                  shape="rounded"
                  style="--media-ratio: 3 / 2;"
                  sizes="(width > 720px) 33vw, 100vw"
                />
                <h2 class="font-display fs-500 text-high-contrast">{name}</h2>
                <p>{ages}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .overview {
    --flow-space: var(--size-700);
  }

  .intro {
    --flow-space: var(--size-400);
  }

  .programs {
    --column-count: 3;
    --column-gap: var(--size-600);
  }

  .program-link {
    --flow-space: var(--size-200);

    display: block;
    color: inherit;
    text-decoration: none;
  }

  .program-link h2 {
    --flow-space: var(--size-400);

    text-decoration: underline;
    text-decoration-thickness: var(--border-width-hairline);
    text-underline-offset: 0.2em;
  }

  .program-link:is(:hover, :focus-visible) h2 {
    color: var(--text-brand);
  }
</style>
