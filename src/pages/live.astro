---
import BaseLayout from "../layouts/BaseLayout.astro";
import Tag from "../components/Tag.astro";
import Statement from "../components/Statement.astro";
import Button from "../components/Button.astro";
import SocialFollow from "../components/SocialFollow.astro";
import ListA from "../components/ListA/ListA.astro";
import { seo } from "../config/seo";
import { locations } from "../config/locations";
import { env } from "cloudflare:workers";
import { youtubeChannelId, type LiveState } from "../config/live-stream";

// Rendered per request so the player follows whichever stream is current
export const prerender = false;

const state: LiveState = JSON.parse(
  (await env.LIVE_KV.get("live")) ?? "null",
) ?? { status: "none" };

const videoId = state.status === "none" ? undefined : state.videoId;

const isLive = state.status === "live";
const startsAt = state.status === "upcoming" ? state.startsAt : undefined;

const playerSrc = videoId
  ? `https://www.youtube.com/embed/${videoId}`
  : `https://www.youtube.com/embed/live_stream?channel=${youtubeChannelId}`;
// Chat only embeds per video, and only on the domain named here. An upcoming
// stream has nothing to chat about yet
const chatSrc = isLive
  ? `https://www.youtube.com/live_chat?v=${videoId}&embed_domain=${Astro.url.hostname}`
  : undefined;
const youtubeHref = videoId
  ? `https://www.youtube.com/watch?v=${videoId}`
  : `${seo.social.youtube}/live`;
---

<BaseLayout
  title="Watch Live"
  description="Worship with Revealing Truth Church online. Watch our Sunday services live at 9:00 and 11:00AM, wherever you are."
  position="static"
>
  <main>
    {/* Dark band continuing the static header's, so the two read as one */}
    <section class="live-player" data-theme="dark">
      <h1 class="visually-hidden">Watch Revealing Truth Church live</h1>
      {/* YouTube refuses to play (error 153) when the embed sends no
          referrer, so the policy is set explicitly */}
      {isLive && <iframe
        src={playerSrc}
        title="Revealing Truth Church live stream"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>}
      {startsAt && (
        <div class="live-countdown">
          <p>Next service starts</p>
          {/* Formatted in the visitor's timezone by the script, so it stays
              hidden until then */}
          <time datetime={startsAt} data-starts-at hidden></time>
          <p data-countdown></p>
        </div>
      )}
      {state.status === "none" && (
        <div class="live-countdown">
          <p>Join us Sundays at 9:00 &amp; 11:00AM</p>
        </div>
      )}
    </section>

    <section class="section">
      <div class="live wrapper equal-columns" data-align="start">
        <div class="flow" style="--flow-space: var(--size-600);">
          <Statement>
            <Tag slot="tag" as="h2">
              watch live
            </Tag>{" "}
            <span class="font-accent text-brand">Church live online.</span>
            Worship with us wherever you are, every Sunday at 9:00 &amp;
            11:00AM.
          </Statement>
          <div class="cluster">
            <Button type="accent" href={seo.givingURL}>
              Give
            </Button>
            {chatSrc && (
              <span data-chat-toggle hidden>
                <Button type="outline">Hide chat</Button>
              </span>
            )}
            <Button type="outline" href={youtubeHref}>
              Watch on YouTube
            </Button>
          </div>
          <SocialFollow
            links={[
              { name: "youtube", label: "YouTube", href: seo.social.youtube },
              {
                name: "instagram",
                label: "Instagram",
                href: seo.social.instagram,
              },
              {
                name: "facebook",
                label: "Facebook",
                href: seo.social.facebook,
              },
            ]}
          />
        </div>
        {chatSrc && <iframe
          id="live-chat"
          class="live__chat"
          src={chatSrc}
          title="Live chat"
          referrerpolicy="strict-origin-when-cross-origin"
          loading="lazy"
        ></iframe>}
      </div>
    </section>

    <section class="section flow" data-divider="top">
      <div class="wrapper">
        <Statement>
          <Tag slot="tag" as="h2">
            visit us
          </Tag>{" "}
          Watching from home?
          <span class="font-accent">Come see us</span>. Three locations, one
          family. We saved you a seat.
        </Statement>
      </div>
      <ListA items={locations} />
    </section>
  </main>
</BaseLayout>

<script>
  // The toggle stays hidden until this runs: without script it would do nothing
  const live = document.querySelector<HTMLElement>(".live");
  const toggle = document.querySelector<HTMLElement>("[data-chat-toggle]");
  const button = toggle?.querySelector("button");

  if (live && toggle && button) {
    button.type = "button";
    button.setAttribute("aria-controls", "live-chat");
    button.setAttribute("aria-expanded", "true");
    toggle.hidden = false;

    button.addEventListener("click", () => {
      const hide = live.dataset.chat !== "hidden";
      if (hide) live.dataset.chat = "hidden";
      else delete live.dataset.chat;
      button.textContent = hide ? "Show chat" : "Hide chat";
      button.setAttribute("aria-expanded", String(!hide));
    });
  }

  const time = document.querySelector<HTMLTimeElement>("[data-starts-at]");
  const countdown = document.querySelector<HTMLElement>("[data-countdown]");
  if (time && countdown) {
    const start = Date.parse(time.dateTime);
    time.textContent = new Intl.DateTimeFormat(undefined, {
      weekday: "long",
      hour: "numeric",
      minute: "2-digit",
      timeZoneName: "short",
    }).format(start);
    time.hidden = false;

    const tick = () => {
      const s = Math.max(0, Math.floor((start - Date.now()) / 1000));
      const d = Math.floor(s / 86400),
        h = Math.floor(s / 3600) % 24;
      const m = Math.floor(s / 60) % 60,
        sec = s % 60;
      countdown.textContent =
        s === 0 ? "Starting soon…" : `${d ? d + "d " : ""}${h}h ${m}m ${sec}s`;
    };
    tick();
    setInterval(tick, 1000);

    // Reload once the cron can have flipped the live state. It runs on each
    // 5-minute mark; 70s later it has finished and any copy of this page the
    // edge cached (60s) is gone. So: the first such moment after the start,
    // then each one after while the stream is late. Waits are capped at a
    // day: setTimeout overflows past ~24.8 days and would fire at once
    const step = 5 * 60 * 1000;
    const settle = 70 * 1000;
    const nextCheck = (after: number) => Math.floor((after - settle) / step) * step + step + settle;
    const day = 24 * 60 * 60 * 1000;
    const wait = nextCheck(Math.max(start, Date.now())) - Date.now();
    setTimeout(() => location.reload(), Math.min(wait, day));
  }
</script>

<style>
  /* Player band ---------------------------------------------------------
     Sits below the static site header, which would otherwise cover the
     player's title bar and take its clicks. Capped at one screen so the
     controls are never far below the fold */
  .live-player iframe {
    display: block;
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    max-block-size: 100svh;
    border: 0;
  }

  /* Countdown / no-stream message, shown in place of the player */
  .live-countdown {
    display: grid;
    gap: var(--size-300);
    justify-items: center;
    padding-block: var(--size-800);
    text-align: center;
  }

  /* Chat ---------------------------------------------------------------- */
  .live__chat {
    inline-size: 100%;
    block-size: clamp(28rem, 70svh, 40rem);
    background-color: var(--clr-neutral-200);
    border: var(--border-width-hairline) solid var(--border-subtle);
    border-radius: var(--border-radius-2);
  }

  /* Exception: chat hidden, the copy takes the full width */
  .live[data-chat="hidden"] {
    --column-count: 1;
  }

  .live[data-chat="hidden"] .live__chat {
    display: none;
  }
</style>
