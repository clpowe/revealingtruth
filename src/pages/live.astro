---
import BaseLayout from "../layouts/BaseLayout.astro";
import Tag from "../components/Tag.astro";
import Statement from "../components/Statement.astro";
import Button from "../components/Button.astro";
import SocialFollow from "../components/SocialFollow.astro";
import ListA from "../components/ListA/ListA.astro";
import { seo } from "../config/seo";
import { locations } from "../config/locations";
import { env } from "cloudflare:workers";
import { readLiveState, youtubeLiveURL } from "../config/live-stream";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store");
const state = await readLiveState(env.LIVE_KV);
const isLive = state.status === "live";
const videoId =
  state.status === "live" || state.status === "upcoming"
    ? state.videoId
    : undefined;
const startsAt = state.status === "upcoming" ? state.startsAt : undefined;
const playerSrc = isLive
  ? `https://www.youtube.com/embed/${state.videoId}`
  : undefined;
const chatSrc = isLive
  ? `https://www.youtube.com/live_chat?v=${state.videoId}&embed_domain=${Astro.url.hostname}`
  : undefined;
const youtubeHref = videoId
  ? `https://www.youtube.com/watch?v=${videoId}`
  : youtubeLiveURL;
const startLabel = startsAt
  ? new Intl.DateTimeFormat("en-US", {
      weekday: "long",
      month: "long",
      day: "numeric",
      hour: "numeric",
      minute: "2-digit",
      timeZone: "America/New_York",
      timeZoneName: "short",
    }).format(new Date(startsAt))
  : "";
---

<BaseLayout
  title="Watch Live"
  description="Worship with Revealing Truth Church online. Watch our Sunday services live at 9:00 and 11:00AM Eastern Time, wherever you are."
  position="static"
>
  <main>
    <live-stream
      data-state={JSON.stringify(state)}
      data-youtube-live={youtubeLiveURL}
    >
      {/* Dark band continuing the static header's, so the two read as one */}
      <section class="live-player" data-theme="dark">
        <h1 class="visually-hidden">Watch Revealing Truth Church live</h1>
        {/* YouTube refuses to play (error 153) when the embed sends no
          referrer, so the policy is set explicitly */}
        <iframe
          data-player
          data-video-id={isLive ? state.videoId : undefined}
          hidden={!isLive}
          src={playerSrc}
          title="Revealing Truth Church live stream"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
        <div class="live-countdown" data-waiting hidden={isLive}>
          <p data-waiting-label>
            {startsAt
              ? "Next service starts"
              : state.status === "unknown"
                ? "Live status is temporarily unavailable. You can check the stream on YouTube."
                : "Join us Sundays at 9:00 & 11:00AM Eastern Time"}
          </p>
          <time datetime={startsAt} data-starts-at hidden={!startsAt}>
            {startLabel}
          </time>
          <p data-countdown></p>
        </div>
        <div class="live-update wrapper" hidden data-update>
          <p data-update-message role="status"></p>
          <button type="button" data-switch hidden>
            Watch the current live service
          </button>
        </div>
      </section>

      <section class="section">
        <div
          class="live wrapper equal-columns"
          data-align="start"
          data-chat={isLive ? undefined : "hidden"}
        >
          <div class="flow" style="--flow-space: var(--size-600);">
            <Statement>
              <Tag slot="tag" as="h2">
                watch live
              </Tag>{" "}
              <span class="font-accent text-brand">Church live online.</span>
              Worship with us wherever you are, every Sunday at 9:00 &amp;
              11:00AM Eastern Time.
            </Statement>
            <div class="cluster">
              <Button type="accent" href={seo.givingURL}>
                Give
              </Button>
              <span data-chat-toggle hidden>
                <Button type="outline">Hide chat</Button>
              </span>
              <span data-youtube-link>
                <Button type="outline" href={youtubeHref}>
                  Watch on YouTube
                </Button>
              </span>
            </div>
            <SocialFollow
              links={[
                { name: "youtube", label: "YouTube", href: seo.social.youtube },
                {
                  name: "instagram",
                  label: "Instagram",
                  href: seo.social.instagram,
                },
                {
                  name: "facebook",
                  label: "Facebook",
                  href: seo.social.facebook,
                },
              ]}
            />
          </div>
          <iframe
            hidden={!chatSrc}
            id="live-chat"
            class="live__chat"
            src={chatSrc}
            title="Live chat"
            referrerpolicy="strict-origin-when-cross-origin"
            loading="lazy"
          ></iframe>
        </div>
      </section>
    </live-stream>

    <section class="section flow" data-divider="top">
      <div class="wrapper">
        <Statement>
          <Tag slot="tag" as="h2">
            visit us
          </Tag>{" "}
          Watching from home?
          <span class="font-accent">Come see us</span>. Three locations, one
          family. We saved you a seat.
        </Statement>
      </div>
      <ListA items={locations} />
    </section>
  </main>
</BaseLayout>

<script>
  import { watchLiveState } from "../lib/live-refresh";
  import { isLiveState, type LiveState } from "../lib/live-state";

  class LiveStream extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const player = this.querySelector<HTMLIFrameElement>("[data-player]")!;
      const waiting = this.querySelector<HTMLElement>("[data-waiting]")!;
      const waitingLabel = this.querySelector<HTMLElement>(
        "[data-waiting-label]",
      )!;
      const time = this.querySelector<HTMLTimeElement>("[data-starts-at]")!;
      const countdown = this.querySelector<HTMLElement>("[data-countdown]")!;
      const layout = this.querySelector<HTMLElement>(".live")!;
      const chat = this.querySelector<HTMLIFrameElement>("#live-chat")!;
      const toggle = this.querySelector<HTMLElement>("[data-chat-toggle]")!;
      const chatButton = toggle.querySelector<HTMLButtonElement>("button")!;
      const youtube = this.querySelector<HTMLAnchorElement>(
        "[data-youtube-link] a",
      )!;
      const update = this.querySelector<HTMLElement>("[data-update]")!;
      const updateMessage = this.querySelector<HTMLElement>(
        "[data-update-message]",
      )!;
      const switchButton =
        this.querySelector<HTMLButtonElement>("[data-switch]")!;
      const initial: unknown = JSON.parse(this.dataset.state!);
      let state: LiveState = isLiveState(initial)
        ? initial
        : { status: "unknown" };
      let timer: ReturnType<typeof setInterval> | undefined;
      let chatHidden = false;

      chatButton.type = "button";
      chatButton.setAttribute("aria-controls", "live-chat");
      const renderChat = () => {
        const available = Boolean(player.dataset.videoId);
        toggle.hidden = !available;
        chat.hidden = !available || chatHidden;
        layout.dataset.chat = chat.hidden ? "hidden" : "visible";
        chatButton.textContent = chatHidden ? "Show chat" : "Hide chat";
        chatButton.setAttribute("aria-expanded", String(!chat.hidden));
      };
      const onChat = () => {
        chatHidden = !chatHidden;
        renderChat();
      };
      chatButton.addEventListener("click", onChat);

      const play = (videoId: string) => {
        player.src = `https://www.youtube.com/embed/${videoId}`;
        player.dataset.videoId = videoId;
        player.hidden = false;
        chat.src = `https://www.youtube.com/live_chat?v=${videoId}&embed_domain=${encodeURIComponent(location.hostname)}`;
      };
      const tick = () => {
        if (
          state.status !== "upcoming" ||
          document.visibilityState !== "visible"
        )
          return;
        const seconds = Math.max(
          0,
          Math.ceil((Date.parse(state.startsAt) - Date.now()) / 1000),
        );
        const days = Math.floor(seconds / 86400);
        countdown.textContent =
          seconds === 0
            ? "Starting soon…"
            : `${days ? days + "d " : ""}${Math.floor(seconds / 3600) % 24}h ${Math.floor(seconds / 60) % 60}m ${seconds % 60}s`;
      };
      const render = () => {
        clearInterval(timer);
        // Only mount automatically if no player is already present. Polls never reset playback.
        if (state.status === "live" && !player.dataset.videoId)
          play(state.videoId);
        const hasPlayer = Boolean(player.dataset.videoId);
        waiting.hidden = hasPlayer;
        time.hidden = state.status !== "upcoming";
        countdown.textContent = "";
        if (state.status === "upcoming") {
          waitingLabel.textContent = "Next service starts";
          time.dateTime = state.startsAt;
          time.textContent = new Intl.DateTimeFormat(undefined, {
            weekday: "long",
            month: "long",
            day: "numeric",
            hour: "numeric",
            minute: "2-digit",
            timeZoneName: "short",
          }).format(new Date(state.startsAt));
          tick();
          if (!hasPlayer) timer = setInterval(tick, 1000);
        } else {
          waitingLabel.textContent =
            state.status === "unknown"
              ? "Live status is temporarily unavailable. You can check the stream on YouTube."
              : "Join us Sundays at 9:00 & 11:00AM Eastern Time";
        }
        youtube.href =
          state.status === "live" || state.status === "upcoming"
            ? `https://www.youtube.com/watch?v=${state.videoId}`
            : this.dataset.youtubeLive!;
        const differentStream =
          state.status === "live" &&
          hasPlayer &&
          state.videoId !== player.dataset.videoId;
        update.hidden =
          !hasPlayer || (state.status === "live" && !differentStream);
        switchButton.hidden = !differentStream;
        const message = differentStream
          ? "Another service is live. Your current video will keep playing."
          : state.status === "unknown"
            ? "We cannot confirm the live status right now. Your video will keep playing."
            : "This service is no longer listed as live. You can keep watching or check YouTube.";
        if (updateMessage.textContent !== message)
          updateMessage.textContent = message;
        renderChat();
      };
      const onSwitch = () => {
        if (state.status !== "live") return;
        play(state.videoId);
        render();
        player.focus();
      };
      switchButton.addEventListener("click", onSwitch);
      render();
      const stop = watchLiveState((next) => {
        state = next;
        render();
      });
      this.cleanup = () => {
        stop();
        clearInterval(timer);
        chatButton.removeEventListener("click", onChat);
        switchButton.removeEventListener("click", onSwitch);
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }
  if (!customElements.get("live-stream"))
    customElements.define("live-stream", LiveStream);
</script>

<style>
  live-stream {
    display: block;
  }
  [hidden] {
    display: none !important;
  }
  .live-update {
    padding-block: var(--size-400);
  }
  .live-update button {
    margin-block-start: var(--size-300);
    padding: var(--size-300) var(--size-400);
    color: var(--text-on-accent);
    background: var(--background-accent);
    border: 0;
    border-radius: var(--border-radius-1);
    cursor: pointer;
  }
  .live-update button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  /* Player band ---------------------------------------------------------
     Sits below the static site header, which would otherwise cover the
     player's title bar and take its clicks. Capped at one screen so the
     controls are never far below the fold */
  .live-player iframe {
    display: block;
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    max-block-size: 100svh;
    border: 0;
  }

  /* Countdown / no-stream message, shown in place of the player */
  .live-countdown {
    display: grid;
    gap: var(--size-300);
    justify-items: center;
    padding-block: var(--size-800);
    text-align: center;
  }

  /* Chat ---------------------------------------------------------------- */
  .live__chat {
    inline-size: 100%;
    block-size: clamp(28rem, 70svh, 40rem);
    background-color: var(--clr-neutral-200);
    border: var(--border-width-hairline) solid var(--border-subtle);
    border-radius: var(--border-radius-2);
  }

  /* Exception: chat hidden, the copy takes the full width */
  .live[data-chat="hidden"] {
    --column-count: 1;
  }

  .live[data-chat="hidden"] .live__chat {
    display: none;
  }
</style>
