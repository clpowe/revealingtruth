---
import BaseLayout from "../layouts/BaseLayout.astro";
import Tag from "../components/Tag.astro";
import Statement from "../components/Statement.astro";
import Button from "../components/Button.astro";
import SocialFollow from "../components/SocialFollow.astro";
import ListA from "../components/ListA/ListA.astro";
import SermonPlayer from "../components/SermonPlayer.astro";
import { seo } from "../config/seo";
import { locations } from "../config/locations";
import { getLiveStream } from "../config/youtube";
import { getSermons } from "../config/sermons";
import { env } from "cloudflare:workers";

// Rendered per request: what's on air changes through the day
export const prerender = false;

// On air: the broadcast, live. Off air: the latest message, so the page
// always has something to play
const live = await getLiveStream(env.LIVE_KV);
const latest = live ? undefined : (await getSermons(env.LIVE_KV))[0];
const video = live
  ? { id: live.videoId, title: live.title || "Live stream" }
  : latest && { id: latest.id, title: latest.title };
const youtubeHref = `${seo.social.youtube}/live`;
---

<BaseLayout
  title="Watch Live"
  description="Worship with Revealing Truth Church online. Watch our Sunday services live at 9:00 and 11:00AM, wherever you are."
  position="static"
>
  <main>
    {/* Dark band continuing the static header's, so the two read as one */}
    <section class="live-player container" data-theme="dark">
      <h1 class="visually-hidden">Watch Revealing Truth Church live</h1>
      {video && (
        <SermonPlayer id={video.id} title={video.title} live={!!live} />
      )}
    </section>

    <section class="section">
      <div class="wrapper">
        <div class="flow" style="--flow-space: var(--size-600);">
          <Statement>
            <Tag slot="tag" as="h2">
              watch live
            </Tag>{" "}
            <span class="font-accent text-brand">Church live online.</span>
            Worship with us wherever you are, every Sunday at 9:00 &amp;
            11:00AM.
          </Statement>
          <div class="cluster">
            <Button type="accent" href={seo.givingURL}>
              Give
            </Button>
            <Button type="outline" href={youtubeHref}>
              Watch on YouTube
            </Button>
          </div>
          <SocialFollow
            links={[
              { name: "youtube", label: "YouTube", href: seo.social.youtube },
              {
                name: "instagram",
                label: "Instagram",
                href: seo.social.instagram,
              },
              {
                name: "facebook",
                label: "Facebook",
                href: seo.social.facebook,
              },
            ]}
          />
        </div>
      </div>
    </section>

    <section class="section flow" data-divider="top">
      <div class="wrapper">
        <Statement>
          <Tag slot="tag" as="h2">
            visit us
          </Tag>{" "}
          Watching from home?
          <span class="font-accent">Come see us</span>. Three locations, one
          family. We saved you a seat.
        </Statement>
      </div>
      <ListA items={locations} />
    </section>
  </main>
</BaseLayout>

<style>
  /* Player band ---------------------------------------------------------
     Sits below the static site header, which would otherwise cover the
     player's controls. Capped at one screen tall (the player is 16:9, so
     its width is capped) so the controls are never below the fold */
  .live-player :global(.sermon-player) {
    max-inline-size: calc(100svh * 16 / 9);
    margin-inline: auto;
  }
</style>
