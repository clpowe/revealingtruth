---
import Tag from "../components/Tag.astro";
import Button from "../components/Button.astro";
import Statement from "../components/Statement.astro";
import Citation from "../components/Citation.astro";
import Icon from "../components/Icon.astro";
import { type Item } from "../components/ListA/ListA.astro";
import ListA from "../components/ListA/ListA.astro";
import ListB from "../components/ListB/ListB.astro";
import ListBItem from "../components/ListB/ListBItem.astro";
import Media from "../components/Media.astro";
import MediaStrip from "../components/MediaStrip.astro";
import Hero from "../components/Hero.astro";
import SocialFollow from "../components/SocialFollow.astro";
import Testimony from "../components/Testimony.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import MenuToggle from "../components/MenuToggle.astro";
import Field from "../components/Field.astro";
import Checkbox from "../components/Checkbox.astro";
import ConnectWidget from "../components/ConnectWidget.astro";

import pastorBryanImage from "../assets/images/PastorBryan.jpg";
import mediaimage from "../assets/images/media-strip.png";
import testimonialImage from "../assets/images/testimonial.png";

import BaseLayout from "../layouts/BaseLayout.astro";

// Data
const listAData: Item[] = [
  {
    index: "tp",
    title: "Tampa",
    href: "/",
    metadata: {
      time: "Sun 9:00 & 11:00AM",
      location: "5201 N. Armenia Ave. Tampa, FL 33603",
    },
  },

  {
    index: "wc",
    title: "Wesley Chapel",
    href: "/",
    metadata: {
      time: "Sun 9:00 & 11:00AM",
      location: "5201 N. Armenia Ave. Tampa, FL 33603",
    },
  },
];
---

<BaseLayout
  title="Components"
  description="Internal component library for the Revealing Truth Church website: tags, buttons, lists, media, testimonies and the other building blocks used across pages."
  noindex
>
  <section class="section flow wrapper" data-padding="compact">
    <article class="flow">
      <header class="flow">
        <h3 class="h3">Tag</h3>
        <code>.tag</code>
        <p style="max-inline-size: 34em;">
          Serif-italic pill that labels a section. Its colours come from the
          theme: black on light grounds, white on dark.
        </p>
      </header>
      <div class="equal-columns">
        <figure class="flow">
          <figcaption>Light</figcaption>
          <div class="fig-content cluster" data-theme="light">
            <Tag>our mission</Tag>
            <Tag>visit us</Tag>
          </div>
        </figure>
        <figure class="flow">
          <figcaption>Dark</figcaption>
          <div class="fig-content cluster" data-theme="dark">
            <Tag>our mission</Tag>
            <Tag>visit us</Tag>
          </div>
        </figure>
      </div>
    </article>
  </section>

  <section class="section flow wrapper" data-padding="compact">
    <article class="flow">
      <header class="flow">
        <h3 class="h3">Button</h3>
        <code>.button</code>
        <p style="max-inline-size: 34em;">
          Pill link or button in DM Sans bold. Hover blends 20% of the text
          colour into the fill, focus shows the focus ring, and pressing scales
          it to 97%.
        </p>
      </header>
      <div class="equal-columns">
        <figure class="flow">
          <figcaption>Light</figcaption>
          <div class="fig-content cluster" data-theme="light">
            <Button>Connect with us</Button>
            <Button type="accent">Connect with us</Button>
            <Button type="outline">Connect with us</Button>
          </div>
        </figure>
        <figure class="flow">
          <figcaption>Dark</figcaption>
          <div class="fig-content cluster" data-theme="dark">
            <Button>Connect with us</Button>
            <Button type="accent">Connect with us</Button>
            <Button type="outline">Connect with us</Button>
          </div>
        </figure>
      </div>
    </article>
  </section>

  <section class="section flow wrapper" data-padding="compact">
    <article class="flow">
      <header class="flow">
        <h3 class="h3">Field</h3>
        <code>.field</code>
        <p style="max-inline-size: 34em;">
          Pill text input in DM Sans; multiline renders a rounded textarea. The
          label is visually hidden and repeated as the placeholder. Focus
          darkens the edge and adds the focus ring.
        </p>
      </header>
      <div class="equal-columns">
        <figure class="flow">
          <figcaption>Light</figcaption>
          <div class="fig-content flow" data-theme="light">
            <Field label="Name" name="demo-name" />
            <Field label="How can we help? (optional)" name="demo-message" multiline />
          </div>
        </figure>
        <figure class="flow">
          <figcaption>Dark</figcaption>
          <div class="fig-content flow" data-theme="dark">
            <Field label="Name" name="demo-name" />
            <Field label="How can we help? (optional)" name="demo-message" multiline />
          </div>
        </figure>
      </div>
    </article>
  </section>

  <section class="section flow wrapper" data-padding="compact">
    <article class="flow">
      <header class="flow">
        <h3 class="h3">Checkbox</h3>
        <code>.checkbox</code>
        <p style="max-inline-size: 34em;">
          A native checkbox restyled as a square box; the tick is drawn with
          clip-path in the theme's background colour.
        </p>
      </header>
      <div class="equal-columns">
        <figure class="flow">
          <figcaption>Light · unchecked and checked</figcaption>
          <div class="fig-content cluster" data-theme="light">
            <Checkbox name="demo-sms">Text me updates</Checkbox>
            <Checkbox name="demo-sms" checked>Text me updates</Checkbox>
          </div>
        </figure>
        <figure class="flow">
          <figcaption>Dark · unchecked and checked</figcaption>
          <div class="fig-content cluster" data-theme="dark">
            <Checkbox name="demo-sms">Text me updates</Checkbox>
            <Checkbox name="demo-sms" checked>Text me updates</Checkbox>
          </div>
        </figure>
      </div>
    </article>
  </section>

  <section class="section flow wrapper" data-padding="compact">
    <article class="flow">
      <header class="flow">
        <h3 class="h3">Connect widget</h3>
        <code>.connect</code>
        <p style="max-inline-size: 34em;">
          Pill fixed to the bottom corner of every page. It opens a contact card
          as a native popover over a dimmed page; the pill's X hides it for the
          rest of the session. The form logs its data to the console for now.
          The live widget is in the corner; below, both parts in place.
        </p>
      </header>
      <figure class="flow">
        <figcaption>Pill and card</figcaption>
        <div class="fig-content" style="background-color: var(--clr-neutral-200);">
          <ConnectWidget inline />
        </div>
      </figure>
    </article>
  </section>

  <section class="section flow wrapper" data-padding="compact">
    <article class="flow">
      <header class="flow">
        <h3 class="h3">Statement</h3>
        <code>.statement</code>
        <p style="max-inline-size: 34em;">
          The large editorial sentence that opens a section. Mix in .font-accent
          for serif phrases and .text-brand for lime.
        </p>
      </header>
      <div class="equal-columns">
        <figure class="flow">
          <figcaption>Light</figcaption>
          <div class="fig-content cluster" data-theme="light">
            <Statement>
              To reveal Christ so people experience a
              <span class="font-accent">new life of peace and truth,</span>{" "}
              discover their divine design, and be equipped to advance God's
              Kingdom.
            </Statement>
          </div>
        </figure>
        <figure class="flow">
          <figcaption>Dark</figcaption>
          <div class="fig-content cluster" data-theme="dark">
            <Statement>
              To reveal Christ so people experience a
              <span class="font-accent text-brand">
                new life of peace and truth,
              </span>{" "}
              discover their divine design, and be equipped to advance God's
              Kingdom.
            </Statement>
          </div>
        </figure>
      </div>
    </article>
  </section>

  <section class="section flow wrapper" data-padding="compact">
    <article class="flow">
      <header class="flow">
        <h3 class="h3">Citation</h3>
        <code>.citation</code>
        <p style="max-inline-size: 34em;">
          Scripture reference in expanded black Archivo, followed by a summary
          line.
        </p>
      </header>
      <div class="equal-columns">
        <figure class="flow">
          <figcaption>Light</figcaption>
          <div class="fig-content cluster" data-theme="light">
            <Citation cite="Jeremiah 33:6">
              Peace, Prosperity, Security, Stability, Health, Healing and Truth
            </Citation>
          </div>
        </figure>
        <figure class="flow">
          <figcaption>Dark</figcaption>
          <div class="fig-content cluster" data-theme="dark">
            <Citation cite="Jeremiah 33:6">
              Peace, Prosperity, Security, Stability, Health, Healing and Truth
            </Citation>
          </div>
        </figure>
      </div>
    </article>
  </section>

  <section class="section flow wrapper" data-padding="compact">
    <article class="flow">
      <header class="flow">
        <h3 class="h3">Icon</h3>
        <code>.icon</code>
        <p style="max-inline-size: 34em;">
          Brand glyphs drawn with a CSS mask, so they take currentColor.
        </p>
      </header>
      <div class="equal-columns">
        <figure class="flow">
          <figcaption>Light · 14px and 32px</figcaption>
          <div class="fig-content flow" data-theme="light">
            <div class="cluster text-high-contrast">
              <Icon name="youtube" label="YouTube" />
              <Icon name="instagram" label="Instagram" />
              <Icon name="facebook" label="Facebook" />
            </div>
            <div class="cluster text-high-contrast" style="--icon-size: 2rem;">
              <Icon name="youtube" label="YouTube" />
              <Icon name="instagram" label="Instagram" />
              <Icon name="facebook" label="Facebook" />
            </div>
          </div>
        </figure>
        <figure class="flow">
          <figcaption>Dark · lime via currentColor</figcaption>
          <div class="fig-content flow" data-theme="dark">
            <div class="cluster text-high-contrast">
              <Icon name="youtube" label="YouTube" />
              <Icon name="instagram" label="Instagram" />
              <Icon name="facebook" label="Facebook" />
            </div>
            <div class="cluster text-brand" style="--icon-size: 2rem;">
              <Icon name="youtube" label="YouTube" />
              <Icon name="instagram" label="Instagram" />
              <Icon name="facebook" label="Facebook" />
            </div>
          </div>
        </figure>
      </div>
    </article>
  </section>

  <section class="section flow wrapper" data-padding="compact">
    <article class="flow">
      <header class="flow">
        <h3 class="h3">List A</h3>
        <code>.list-A</code>
        <p style="max-inline-size: 34em;">
          Linked directory rows: serif-italic index, expanded display title, and
          time and location meta. Hover and focus turn the title lime.
        </p>
      </header>
      <div class="">
        <figure class="flow">
          <figcaption>Light</figcaption>
          <div class="fig-content-b flow" data-theme="light">
            <ListA items={listAData} />
          </div>
        </figure>
        <figure class="flow">
          <figcaption>Dark</figcaption>
          <div class="fig-content-b flow" data-theme="dark">
            <ListA items={listAData} />
          </div>
        </figure>
      </div>
    </article>
  </section>

  <section class="section flow wrapper" data-padding="compact">
    <article class="flow">
      <header class="flow">
        <h3 class="h3">List B</h3>
        <code>.list-B</code>
        <p style="max-inline-size: 34em;">
          Bold heading with a serif-italic accent word, a short line of copy,
          and a hairline rule beneath each item.
        </p>
      </header>
      <div class="">
        <figure class="flow">
          <figcaption>Light</figcaption>
          <div class="fig-content-b flow" data-theme="light">
            <ListB>
              <ListBItem>
                <Fragment slot="title">
                  We ask <span class="font-accent">why</span>
                </Fragment>
                Because where purpose is unknown, abuse is inevitable.
              </ListBItem>
              <ListBItem>
                <Fragment slot="title">
                  <span class="font-accent">Truth</span> sets us free
                </Fragment>
                The accent can sit anywhere in the heading.
              </ListBItem>
            </ListB>
          </div>
        </figure>
        <figure class="flow">
          <figcaption>Dark</figcaption>
          <div class="fig-content-b flow" data-theme="dark">
            <ListB>
              <ListBItem>
                <Fragment slot="title">
                  We ask <span class="font-accent">why</span>
                </Fragment>
                Because where purpose is unknown, abuse is inevitable.
              </ListBItem>
              <ListBItem>
                <Fragment slot="title">
                  <span class="font-accent">Truth</span> sets us free
                </Fragment>
                The accent can sit anywhere in the heading.
              </ListBItem>
            </ListB>
          </div>
        </figure>
      </div>
    </article>
  </section>

  <section class="section flow wrapper" data-padding="compact">
    <article class="flow">
      <header class="flow">
        <h3 class="h3">Media</h3>
        <code>.media</code>
        <p style="max-inline-size: 34em;">
          Photography inside the grid. Set the crop with --media-ratio;
          data-shape="rounded" adds the 12px radius used on leader photos.
        </p>
      </header>
      <div class="equal-columns">
        <figure class="flow">
          <Media
            src={pastorBryanImage}
            alt="Pastor Bryan speaking on stage under spotlights"
            style="--media-ratio: 3 / 2;"
            sizes="(width > 720px) 50vw, 100vw"
          />
          <figcaption>Default · --media-ratio: 3 / 2</figcaption>
        </figure>
        <figure class="flow">
          <Media
            src={pastorBryanImage}
            alt="Pastor Bryan speaking on stage under spotlights"
            shape="rounded"
            style="--media-ratio: 3 / 2;"
            sizes="(width > 720px) 50vw, 100vw"
          />
          <figcaption>data-shape="rounded"</figcaption>
        </figure>
      </div>
    </article>
  </section>

  <section class="section flow wrapper" data-padding="compact">
    <article class="flow">
      <header class="flow">
        <h3 class="h3">Media strip</h3>
        <code>.media-strip</code>
        <p style="max-inline-size: 34em;">
          Full-bleed black-and-white photograph between sections. The ratio
          widens at each breakpoint.
        </p>
      </header>
      <div class="fig-content-b">
        <MediaStrip
          src={mediaimage}
          alt="Pastor Bryan speaking on stage under spotlights"
        />
      </div>
    </article>
  </section>

  <section class="section flow wrapper" data-padding="compact">
    <article class="flow">
      <header class="flow">
        <h3 class="h3">Hero</h3>
        <code>.media-overlay + .hero</code>
        <p style="max-inline-size: 34em;">
          Image or video under a gradient scrim, with a display title and the
          follow row. The image always loads first as the LCP element; a video,
          when given, fades in over it unless reduced motion or Save-Data is on.
        </p>
      </header>
      <div class="fig-content-b">
        <Hero image={pastorBryanImage} alt="">
          Experience <br />
          <span class="font-accent text-brand">new</span> life!
          <SocialFollow
            slot="aside"
            links={[
              { name: "youtube", label: "YouTube", href: "#" },
              { name: "instagram", label: "Instagram", href: "#" },
              { name: "facebook", label: "Facebook", href: "#" },
            ]}
          />
        </Hero>
      </div>
    </article>
  </section>

  <section class="section flow wrapper" data-padding="compact">
    <article class="flow">
      <header class="flow">
        <h3 class="h3">Testimony</h3>
        <code>.media-overlay + .testimony</code>
        <p style="max-inline-size: 34em;">
          Centred serif quote and logo over photography, using the default
          scrim.
        </p>
      </header>
      <div class="fig-content-b">
        <Testimony
          image={testimonialImage}
          alt="A boy celebrating as he is baptised in a pool"
        >
          “We are Revealing Truth Church—where lives are changed, communities
          are impacted, and Christ is put on display through the Simple Truth of
          God’s Word.”
        </Testimony>
      </div>
    </article>
  </section>

  <section class="section flow wrapper" data-padding="compact">
    <article class="flow">
      <header class="flow">
        <h3 class="h3">Site header</h3>
        <code>.site-header · .site-menu · .menu-toggle</code>
        <p style="max-inline-size: 34em;">
          Logo and menu toggle, absolutely positioned over the hero. The toggle
          opens a frosted popover card that drops in from the top of the
          viewport, with grouped link columns over the call-to-action buttons
          and partner logos; its close toggle crosses from bars into an X.
        </p>
      </header>
      <figure class="flow">
        <figcaption>Over the hero</figcaption>
        <div class="fig-content-b" style="position: relative;">
          <SiteHeader />
          <Hero image={pastorBryanImage} alt="">
            Experience <br />
            <span class="font-accent text-brand">new</span> life!
          </Hero>
        </div>
      </figure>
      <figure class="flow">
        <figcaption>Menu toggle states</figcaption>
        <div class="fig-content cluster" data-theme="dark">
          <div class="flow">
            <MenuToggle />
            <code>aria-expanded="false"</code>
          </div>
          <div class="flow">
            <MenuToggle expanded />
            <code>aria-expanded="true"</code>
          </div>
        </div>
      </figure>
    </article>
  </section>

  <section class="section flow wrapper" data-padding="compact">
    <article class="flow">
      <header class="flow">
        <h3 class="h3">Site footer</h3>
        <code>.site-footer</code>
        <p style="max-inline-size: 34em;">
          Logo, address and copyright in DM Sans. Stacked on mobile, logo left
          of two lines on tablet, three columns on desktop.
        </p>
      </header>
      <div class="fig-content-b">
        <SiteFooter />
      </div>
    </article>
  </section>
</BaseLayout>

<style>
  .fig-content {
    padding: var(--size-600);
    border-radius: var(--border-radius-2);
    border: 1px solid var(--clr-neutral-200);
  }
  .fig-content-b {
    border-radius: var(--border-radius-2);
    border: 1px solid var(--clr-neutral-200);
    overflow: clip;
  }

  figcaption {
    font-family: var(--ff-ui);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--clr-neutral-600);
  }

  code {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.8125rem;
    line-height: 1.5;
    padding: 0.15em 0.5em;
    color: var(--clr-neutral-800);
    background: var(--clr-brand-400);
    border-radius: var(--border-radius-1);
  }

  .h3 {
    font-size: var(--fs-600);
    line-height: 1.1;
    font-family: var(--ff-heading);
    font-weight: var(--fw-semi-bold);
    line-height: var(--lh-heading);
    color: var(--text-high-contrast);
  }
</style>
