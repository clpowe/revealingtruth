---
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"input">, "type">;

const props = Astro.props;
---

<label class="checkbox">
  <input class="checkbox__input" type="checkbox" {...props} />
  <span><slot /></span>
</label>

<style>
  /* Checkbox — a real input, restyled: square box, tick drawn with
     clip-path so it takes the theme's colours */
  .checkbox {
    display: inline-flex;
    align-items: center;
    gap: var(--size-300);
    font-family: var(--ff-ui);
    font-size: var(--font-size-sm);
    line-height: var(--lh-heading);
    color: var(--text-main);
    cursor: pointer;
  }

  .checkbox__input {
    appearance: none;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    background-color: var(--background-main);
    border: var(--border-width-hairline) solid var(--text-main);
    border-radius: var(--border-radius-1);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .checkbox__input::before {
    content: "";
    inline-size: 0.75rem;
    block-size: 0.75rem;
    background-color: var(--background-main);
    clip-path: polygon(14% 44%, 0 58%, 40% 100%, 100% 22%, 86% 8%, 40% 72%);
    scale: 0;
    transition: scale var(--duration-fast) var(--ease-out);
  }

  .checkbox__input:checked {
    background-color: var(--text-high-contrast);
    border-color: var(--text-high-contrast);
  }

  .checkbox__input:checked::before {
    scale: 1;
  }

  .checkbox:hover .checkbox__input {
    border-color: var(--text-high-contrast);
  }

  .checkbox__input:focus-visible {
    outline: var(--border-width-2) solid var(--focus-ring);
    outline-offset: 3px;
  }
</style>
