---
interface Props {
  align?: "center";
}

const { align } = Astro.props;
const hasTag = Astro.slots.has("tag");
---

<div class="statement" data-align={align}>
  {hasTag && (
    <>
      <slot name="tag" />{" "}
    </>
  )}
  <p>
    <slot />
  </p>
</div>

<style>
  .statement {
    font-family: var(--ff-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--fw-semi-bold);
    line-height: var(--lh-heading);
    letter-spacing: -0.005em;
    color: var(--text-main);
    max-inline-size: 65ch;
    text-wrap: balance;
    overflow-wrap: break-word;

    h2 {
      transform: translateY(-0.25em);
    }
  }

  .statement[data-align="center"] {
    inline-size: 100%;
    max-inline-size: 28em;
    margin-inline: auto;
    text-align: center;
    color: var(--text-strong);
  }

  /* Inline so the tag (often a heading) sits at the start of the sentence */
  p {
    display: inline;
  }
</style>
