---
interface Props {
  name: "youtube" | "instagram" | "facebook";
  label?: string;
}

const { name, label } = Astro.props;
---

<span
  class="icon"
  data-icon={name}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
></span>

<style>
  .icon {
    display: inline-block;
    flex-shrink: 0;
    inline-size: var(--icon-size, 0.875rem);
    block-size: var(--icon-size, 0.875rem);
    background-color: currentColor;
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: contain;
  }

  .icon[data-icon="youtube"] {
    mask-image: url("../assets/icons/youtube.svg");
  }

  .icon[data-icon="instagram"] {
    mask-image: url("../assets/icons/instagram.svg");
  }

  .icon[data-icon="facebook"] {
    mask-image: url("../assets/icons/facebook.svg");
  }
</style>
