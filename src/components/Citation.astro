---
interface Props {
  cite: string;
}

const { cite } = Astro.props;
---

<p class="citation cluster">
  <cite>{cite}</cite>
  <span>
    <slot />
  </span>
</p>

<style>
  .citation {
    --cluster-gap: var(--size-200) var(--size-400);

    font-size: var(--font-size-sm);
    line-height: 1.6;
    color: var(--text-strong);

    cite {
      font-family: var(--ff-heading);
      font-style: normal;
      font-weight: var(--fw-black);
      font-stretch: var(--font-stretch-display);
    }
  }
</style>
