---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface VideoSource {
  src: string;
  type: string;
  media?: string;
}

interface Props {
  image: ImageMetadata;
  alt: string;
  video?: VideoSource[];
}

const { image, alt, video } = Astro.props;
---

<section class="hero media-overlay" data-theme="dark">
  {/* The image is the LCP element and the video's poster: priority makes it
      eager, high fetchpriority and responsive, which a poster attribute is not */}
  <Image class="media" src={image} alt={alt} layout="full-width" priority />
  {video && (
    <video
      class="media"
      data-hero-video
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
    >
      {video.map((source) => (
        <source src={source.src} type={source.type} media={source.media} />
      ))}
    </video>
  )}
  <div class="hero__content wrapper repel" data-align="end">
    <h1 class="hero__title font-display">
      <slot />
    </h1>
    <slot name="aside" />
  </div>
  {video && (
    <button class="toggle" type="button" data-hero-toggle hidden>
      Pause
    </button>
  )}
</section>

<script>
  type ConnectionNavigator = Navigator & {
    connection?: { saveData?: boolean };
  };

  const HLS_TYPE = "application/x-mpegURL";

  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const saveData = (navigator as ConnectionNavigator).connection?.saveData;

  // Safari plays HLS from <source>; elsewhere hls.js feeds the manifest
  // through MSE. Imported on demand so it only loads when a video will play
  async function attachHls(video: HTMLVideoElement) {
    const source = video.querySelector<HTMLSourceElement>(
      `source[type="${HLS_TYPE}"]`,
    );
    if (!source || video.canPlayType(HLS_TYPE)) return;

    const { default: Hls } = await import("hls.js");
    if (!Hls.isSupported()) return;

    // Cap renditions to the element's size so phones get the small one
    const hls = new Hls({ capLevelToPlayerSize: true });
    hls.loadSource(source.src);
    hls.attachMedia(video);
  }

  // Video is an enhancement: without JS, with reduced motion or Save-Data,
  // the image stays and preload="none" means no video bytes are fetched
  if (!reduceMotion && !saveData) {
    for (const hero of document.querySelectorAll(".hero")) {
      const video = hero.querySelector<HTMLVideoElement>("[data-hero-video]");
      const toggle =
        hero.querySelector<HTMLButtonElement>("[data-hero-toggle]");
      if (!video || !toggle) continue;

      video.addEventListener("playing", () => {
        video.dataset.playing = "";
        toggle.textContent = "Pause";
      });
      video.addEventListener("pause", () => {
        toggle.textContent = "Play";
      });
      // Stream's audio track runs a few ms past the video, so under MSE
      // playback stalls just short of duration and `loop` never fires
      video.addEventListener("waiting", () => {
        if (video.duration - video.currentTime < 0.5) video.currentTime = 0;
      });
      toggle.addEventListener("click", () => {
        if (video.paused) video.play();
        else video.pause();
      });

      toggle.hidden = false;
      attachHls(video)
        .catch(() => {})
        .then(() => video.play())
        .catch(() => {});
    }
  }
</script>

<style>
  .media-overlay {
    position: relative;
    display: grid;
    isolation: isolate;
    overflow: clip;
    color: var(--text-on-media);
    background-color: var(--background-dark);
  }

  /* Absolute so the media's intrinsic size never sets the block's height */
  .media {
    position: absolute;
    inset: 0;
    z-index: -2;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: var(--media-focus, 50% 50%);
  }

  /* Video sits over the image and fades in once frames are playing */
  video.media {
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  video.media[data-playing] {
    opacity: 1;
  }

  .media-overlay::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.75),
      rgb(0 0 0 / 0.2) 50%,
      rgb(0 0 0 / 0)
    );
  }

  .hero {
    --media-focus: 50% 30%;
    align-items: end;
    min-block-size: clamp(35rem, 56vw, 100svh);
  }

  .hero__content {
    --repel-gap: var(--size-500) var(--size-700);
    padding-block: var(--size-1000) clamp(2.5rem, 1.5rem + 2.5vw, 4rem);
  }

  .hero__title {
    font-size: var(--font-size-heading-lg);
    color: inherit;
  }

  .toggle {
    position: absolute;
    inset-block-start: var(--size-500);
    inset-inline-end: var(--size-500);
    padding: 0.4em 1em;
    font-family: var(--ff-ui);
    font-size: var(--font-size-xs);
    color: inherit;
    background-color: rgb(0 0 0 / 0.4);
    border: var(--border-width-hairline) solid currentColor;
    border-radius: var(--border-radius-pill);
  }

  .toggle:focus-visible {
    outline: var(--border-width-2) solid var(--focus-ring);
    outline-offset: 3px;
  }
</style>
