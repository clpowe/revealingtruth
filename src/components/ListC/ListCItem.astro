---
export type Item = {
  href: string;
  /** Already formatted: "Wed, Sep 30" */
  date: string;
  /** Machine-readable date for <time>: "2026-09-30" */
  datetime: string;
  /** Italic kicker: "Wednesday night", "Better Together, part 3 of 3" */
  label: string;
  title: string;
  /** Right-aligned detail: the speaker */
  meta?: string;
  /** The row that's playing: its title takes the brand colour */
  current?: boolean;
};

type Props = Item;

const { href, date, datetime, label, title, meta, current } = Astro.props;
---

<li class="list-C-item">
  <a href={href} class="link" aria-current={current ? "true" : undefined}>
    <time class="date" datetime={datetime}>{date}</time>
    <span class="label">{label}</span>
    <span class="title">{title}</span>
    {meta && <span class="meta">{meta}</span>}
  </a>
</li>

<style>
  .list-C-item {
    border-block-start: var(--border-width-hairline) solid var(--border-subtle);
  }

  /* Phone: date and label share a line, title and meta below. From tablet:
     four columns, the meta pushed to the end */
  .link {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "date label"
      "title title"
      "meta meta";
    align-items: baseline;
    gap: var(--size-100) var(--size-400);
    padding-block: var(--size-500);
    color: inherit;
    text-decoration: none;
  }

  @media (width > 720px) {
    .link {
      grid-template-columns: 7.5rem 10rem minmax(0, 1fr) auto;
      grid-template-areas: "date label title meta";
      gap: var(--size-500);
    }
  }

  /* The display voice's expanded black weight, kept in sentence case */
  .date {
    grid-area: date;
    font-family: var(--ff-heading);
    font-size: var(--font-size-sm);
    font-stretch: var(--font-stretch-display);
    font-weight: var(--fw-black);
    line-height: var(--lh-heading);
    color: var(--text-high-contrast);
  }

  .label {
    grid-area: label;
    font-family: var(--ff-accent);
    font-style: italic;
    line-height: var(--lh-heading);
    color: var(--text-brand);
  }

  .title {
    grid-area: title;
    font-family: var(--ff-heading);
    font-size: var(--fs-500);
    font-weight: var(--fw-semi-bold);
    line-height: var(--lh-heading);
    color: var(--text-high-contrast);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .link:hover .title,
  .link:focus-visible .title,
  .link[aria-current] .title {
    color: var(--text-brand);
  }

  .meta {
    grid-area: meta;
    font-family: var(--ff-ui);
    font-size: var(--font-size-sm);
    color: var(--text-main);
  }

  @media (width > 720px) {
    .meta {
      text-align: end;
    }
  }
</style>
