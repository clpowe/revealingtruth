<live-banner>
  <aside class="live-banner" hidden aria-label="Live stream">
    <div class="live-banner__inner wrapper repel">
      <p class="live-banner__message">
        <span class="live-banner__badge" data-badge></span>
        <span class="live-banner__text" data-message></span>
      </p>
      <a class="live-banner__link" href="/live">
        <span data-link-label></span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </aside>
</live-banner>

<script>
  import { watchLiveState } from "../lib/live-refresh";
  import { bannerStatus, type LiveState } from "../lib/live-state";

  class LiveBanner extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const banner = this.querySelector<HTMLElement>(".live-banner")!;
      const badge = this.querySelector<HTMLElement>("[data-badge]")!;
      const message = this.querySelector<HTMLElement>("[data-message]")!;
      const label = this.querySelector<HTMLElement>("[data-link-label]")!;
      let state: LiveState = { status: "unknown" };
      let timer: ReturnType<typeof setInterval> | undefined;

      const render = () => {
        if (document.visibilityState !== "visible") return;
        const status = bannerStatus(state);
        banner.hidden = !status;
        if (!status) return;
        banner.dataset.status = status;
        badge.textContent = status === "live" ? "Live" : "Starting soon";
        label.textContent = status === "live" ? "Join now" : "Get ready";
        if (state.status === "upcoming") {
          const seconds = Math.max(
            0,
            Math.ceil((Date.parse(state.startsAt) - Date.now()) / 1000),
          );
          message.textContent =
            seconds === 0
              ? "Service begins any moment"
              : `Service begins in ${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`;
        } else {
          message.textContent = "Worship is live now";
        }
      };
      const stop = watchLiveState((next) => {
        state = next;
        clearInterval(timer);
        render();
        // Also brings a scheduled banner into its 15-minute window between polls.
        if (state.status === "upcoming") timer = setInterval(render, 1000);
      });
      this.cleanup = () => {
        stop();
        clearInterval(timer);
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }
  if (!customElements.get("live-banner"))
    customElements.define("live-banner", LiveBanner);
</script>

<style>
  live-banner {
    display: block;
  }
  [hidden] {
    display: none !important;
  }
  .live-banner {
    padding-block: var(--size-300);
    font-family: var(--ff-ui);
    font-size: var(--font-size-sm);
    line-height: var(--lh-heading);
    color: var(--text-on-accent);
    background-color: var(--background-accent);
  }

  .live-banner[data-status="upcoming"] {
    color: var(--clr-neutral-100);
    background-color: var(--clr-neutral-900);
    border-block-end: var(--border-width-hairline) solid var(--clr-neutral-800);
  }

  .live-banner__message {
    display: flex;
    align-items: center;
    gap: var(--size-400);
    min-inline-size: 0;
  }

  .live-banner__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--size-200);
    font-weight: var(--fw-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .live-banner__badge::before {
    content: "";
    inline-size: 0.5em;
    aspect-ratio: 1;
    background-color: currentColor;
    border-radius: var(--border-radius-pill);
  }

  .live-banner[data-status="upcoming"] .live-banner__badge {
    color: var(--clr-brand-400);
  }

  /* Phones: badge and link only */
  .live-banner__text {
    display: none;
  }

  @media (width > 720px) {
    .live-banner__text {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  /* Digits keep one width, so the ticking countdown does not jitter. */
  .live-banner__text {
    font-variant-numeric: tabular-nums;
  }

  .live-banner__inner {
    --repel-gap: var(--size-400);
    flex-wrap: nowrap;
  }

  /* Flex gap, not a space character: Astro drops the line break between
     the label and the arrow */
  .live-banner__link {
    display: inline-flex;
    gap: var(--size-100);
    flex-shrink: 0;
    font-weight: var(--fw-bold);
    color: inherit;
    text-decoration: none;
  }

  .live-banner__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* The site's green ring would vanish on the green bar */
  .live-banner__link:focus-visible {
    outline: var(--border-width-2) solid currentColor;
    outline-offset: 4px;
    border-radius: var(--border-radius-1);
  }
</style>
