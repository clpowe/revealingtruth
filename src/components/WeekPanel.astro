---
import Tag from "./Tag.astro";
import Button from "./Button.astro";

export type WeekPanelItem = {
  href: string;
  /** "Sun" */
  weekday: string;
  /** "30" */
  day: string;
  /** Italic kicker: "Message", "Wednesday night", "Better Together, part 2 of 3" */
  label: string;
  title: string;
  /** Speaker, gathering: joined with " · " */
  meta?: string[];
  playing?: boolean;
};

interface Props {
  /** The week's Sunday, already formatted: "Aug 30, 2026" */
  heading: string;
  previous: string;
  next: string;
  items: WeekPanelItem[];
}

const { heading, previous, next, items } = Astro.props;
---

<section class="week-panel" aria-labelledby="week-panel-heading">
  <div class="week-panel__body">
  <header class="week-panel__header">
    <Tag>week of</Tag>
    <h2 id="week-panel-heading" class="week-panel__heading font-display">{heading}</h2>
    <nav class="cluster" style="--cluster-gap: var(--size-300);" aria-label="Weeks">
      <Button type="outline" shape="circle" label="Previous week" href={previous}>←</Button>
      <Button type="outline" shape="circle" label="Next week" href={next}>→</Button>
    </nav>
  </header>

  {items.length ? (
    <ul role="list" class="week-panel__list">
      {items.map((item) => (
        <li>
          <a
            class="week-panel__item"
            href={item.href}
            aria-current={item.playing ? "true" : undefined}
          >
            <span class="week-panel__date">
              <span class="week-panel__weekday">{item.weekday}</span>
              <span class="week-panel__day">{item.day}</span>
            </span>
            <span class="week-panel__text">
              <span class="week-panel__label">{item.label}</span>
              <span class="week-panel__title">{item.title}</span>
              {(item.playing || Boolean(item.meta?.length)) && (
                <span class="week-panel__meta">
                  {item.playing && <strong>Playing</strong>}
                  {item.playing && item.meta?.length ? " · " : ""}
                  {item.meta?.join(" · ")}
                </span>
              )}
            </span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="week-panel__empty">No services streamed this week.</p>
  )}
  </div>
</section>

<style>
  /* Sized by its placement: a sidebar card, or full width under a wide
     player. The body reads that width (a container can't query itself) */
  .week-panel {
    container-type: inline-size;
    padding: var(--size-500);
    border: var(--border-width-hairline) solid var(--border-subtle);
    border-radius: var(--border-radius-2);
  }

  .week-panel__body {
    display: grid;
    gap: var(--size-500);
  }

  /* Wide: the week's name on the left, its services in columns beside it */
  @container (width > 48rem) {
    .week-panel__body {
      grid-template-columns: max-content minmax(0, 1fr);
      align-items: start;
      gap: var(--size-700);
    }

    .week-panel__list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
      column-gap: var(--size-600);
    }

    .week-panel__empty {
      align-self: center;
    }
  }

  .week-panel__header {
    display: grid;
    justify-items: start;
    gap: var(--size-300);
  }

  .week-panel__heading {
    font-size: var(--fs-700);
    color: var(--text-high-contrast);
  }

  .week-panel__list > li {
    border-block-start: var(--border-width-hairline) solid var(--border-subtle);
  }

  .week-panel__item {
    display: flex;
    align-items: start;
    gap: var(--size-400);
    padding-block: var(--size-400);
    color: inherit;
    text-decoration: none;
  }

  /* Day block: black-weight date on a quiet tile; the playing one lights up */
  .week-panel__date {
    display: grid;
    place-content: center;
    justify-items: center;
    flex-shrink: 0;
    inline-size: 4.5rem;
    aspect-ratio: 1;
    color: var(--text-high-contrast);
    /* The theme's quiet surface: neutral-800 on dark, neutral-200 on light */
    background-color: var(--border-subtle);
    border-radius: var(--border-radius-1);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .week-panel__item[aria-current] .week-panel__date {
    color: var(--text-on-accent);
    background-color: var(--background-accent);
  }

  .week-panel__weekday {
    font-family: var(--ff-ui);
    font-size: var(--font-size-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .week-panel__day {
    font-family: var(--ff-heading);
    font-size: var(--fs-700);
    font-stretch: var(--font-stretch-display);
    font-weight: var(--fw-black);
    line-height: 1;
  }

  .week-panel__text {
    display: grid;
    gap: var(--size-100);
    line-height: var(--lh-heading);
  }

  .week-panel__label {
    font-family: var(--ff-accent);
    font-style: italic;
    color: var(--text-brand);
  }

  .week-panel__title {
    font-family: var(--ff-heading);
    font-size: var(--fs-500);
    font-weight: var(--fw-semi-bold);
    color: var(--text-high-contrast);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .week-panel__item:hover .week-panel__title,
  .week-panel__item:focus-visible .week-panel__title {
    color: var(--text-brand);
  }

  .week-panel__meta {
    font-family: var(--ff-ui);
    font-size: var(--font-size-sm);
  }

  .week-panel__meta strong {
    color: var(--text-high-contrast);
  }

  .week-panel__empty {
    font-family: var(--ff-ui);
    font-size: var(--font-size-sm);
  }
</style>
