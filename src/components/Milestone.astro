---
interface Props {
  /** Standout year or figure, e.g. "1991" */
  value: string;
}

const { value } = Astro.props;
---

<p class="milestone">
  <span class="milestone__value">{value}</span>
  <span class="milestone__note">
    <slot />
  </span>
</p>

<style>
  .milestone {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--size-300) var(--size-500);
    padding-block-start: var(--size-500);
    border-block-start: var(--border-width-hairline) solid var(--border-subtle);
  }

  .milestone__value {
    flex-shrink: 0;
    font-family: var(--ff-accent);
    font-size: clamp(2.25rem, 1.8rem + 1.5vw, 3.0625rem);
    font-style: italic;
    font-weight: var(--fw-regular);
    line-height: 1.1;
    color: var(--text-brand);
  }

  .milestone__note {
    flex: 1 1 12rem;
    min-inline-size: 0;
    max-inline-size: 28ch;
    font-family: var(--ff-ui);
    font-size: var(--font-size-xs);
    line-height: 1.55;
    color: var(--text-main);
  }
</style>
