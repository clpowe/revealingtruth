---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import logo from "../assets/logo/revealing-truth-logo.svg";

interface Props {
  image: ImageMetadata;
  alt: string;
}

const { image, alt } = Astro.props;
---

<section class="testimony media-overlay" data-theme="dark">
  <Image class="media" src={image} alt={alt} layout="full-width" />
  <figure class="testimony__content wrapper">
    <blockquote class="testimony__quote">
      <p><slot /></p>
    </blockquote>
    <figcaption>
      <Image class="testimony__logo" src={logo} alt="Revealing Truth Church" />
    </figcaption>
  </figure>
</section>

<style>
  /* Testimony — centred quote + watermark logo over photography ---------- */
  .testimony {
    place-items: center;
    min-block-size: clamp(26rem, 48vw, 43rem);
    padding-block: var(--section-padding);
  }

  .testimony__content {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .testimony__quote {
    max-inline-size: 24em;
    font-family: var(--ff-accent);
    font-size: var(--font-size-heading-sm);
    font-style: italic;
    line-height: 1.25;
  }

  .testimony__logo {
    inline-size: 6.25rem;
    block-size: auto;
  }
</style>
