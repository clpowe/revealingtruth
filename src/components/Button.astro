---
interface Props {
  type?: "outline" | "accent";
  /** "circle" fits a single icon or glyph; give it a label */
  shape?: "circle";
  /** Accessible name, for buttons whose content doesn't say what they do */
  label?: string;
  /** Renders a link instead of a button */
  href?: string;
  /** The selected one of a set of links, like the year shown: tells screen
      readers what the filled style shows */
  current?: boolean;
}

const { type, shape, label, href, current } = Astro.props;
const Element = href ? "a" : "button";
---

<Element
  class="button"
  data-type={type}
  data-shape={shape}
  aria-label={label}
  aria-current={current ? "page" : undefined}
  href={href}
>
  <slot />
</Element>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    padding: 0.85em 2em;
    font-family: var(--ff-ui);
    font-size: var(--font-size-sm);
    font-weight: var(--fw-bold);
    line-height: 1.2;
    text-decoration: none;
    color: var(--button-color, var(--background-main));
    background-color: var(--button-background, var(--text-high-contrast));
    border: var(--border-width-2) solid var(--button-border, transparent);
    border-radius: var(--border-radius-pill);
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      scale var(--duration-fast) var(--ease-out);
  }

  .button[data-type="accent"] {
    --button-color: var(--text-on-accent);
    --button-background: var(--background-accent);
  }

  .button[data-type="outline"] {
    --button-color: var(--text-high-contrast);
    --button-background: transparent;
    --button-border: currentColor;
  }

  .button[data-shape="circle"] {
    inline-size: 2.5rem;
    block-size: 2.5rem;
    padding: 0;
    border-width: var(--border-width-hairline);
    font-size: var(--font-size-regular);
  }

  /* Icon buttons sit in quieter company: a hairline in the border colour */
  .button[data-shape="circle"][data-type="outline"] {
    --button-border: var(--border-subtle);
  }

  /* Hover: blend 20% of the text colour into the variant's own background
     (solid fills shift visibly, outline gets a tint). sRGB, not oklab:
     oklab barely moves black (#000 -> #0b0b0b at 15%) */
  .button:hover {
    background-color: color-mix(
      in srgb,
      var(--button-background, var(--text-high-contrast)) 80%,
      var(--button-color, var(--background-main))
    );
  }

  .button:focus-visible {
    outline: var(--border-width-2) solid var(--focus-ring);
    outline-offset: 3px;
  }

  .button:active {
    scale: 0.97;
  }
</style>
