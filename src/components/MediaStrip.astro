---
import type { ImageMetadata } from "astro";
import Media from "./Media.astro";

interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;
---

<figure class="media-strip">
  <Media src={src} alt={alt} />
</figure>

<style>
  .media-strip {
    --media-ratio: 3 / 2;

    background-color: var(--background-dark);
  }

  @media (width > 720px) {
    .media-strip {
      --media-ratio: 5 / 2;
    }
  }

  @media (width > 1080px) {
    .media-strip {
      --media-ratio: 3 / 1;
    }
  }
</style>
