---
import { Image } from "astro:assets";

import logo from "../assets/logo/revealing-truth-logo.svg";

const year = new Date().getFullYear();
---

<footer class="site-footer" data-theme="dark">
  <div class="site-footer__inner wrapper">
    <a class="site-footer__logo" href="/">
      <Image src={logo} alt="Revealing Truth Church home" />
    </a>
    <address>
      5201 N. Armenia Ave, Tampa, FL 33603 ·{" "}
      <a href="tel:+18133541135">813-354-1135</a>
    </address>
    <p>
      © {year} Revealing Truth Ministries · <a href="/connect">Connect</a> ·{" "}
      <a href="/privacy">Privacy</a>
    </p>
  </div>
</footer>

<style>
  /* Site footer ---------------------------------------------------------- */
  .site-footer {
    padding-block: var(--size-600);
    font-family: var(--ff-ui);
    font-size: var(--font-size-sm);
    line-height: 1.6;
    border-block-start: var(--border-width-hairline) solid var(--border-subtle);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--size-300);
    justify-items: start;
  }

  .site-footer__logo {
    margin-block-end: var(--size-400);
  }

  .site-footer__logo img {
    inline-size: 6.25rem;
    block-size: auto;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (width > 720px) {
    .site-footer__inner {
      grid-template-columns: auto 1fr;
      align-items: center;
      column-gap: var(--size-500);
      row-gap: var(--size-100);
    }

    .site-footer__logo {
      grid-row: span 2;
      margin-block-end: 0;
    }
  }

  @media (width > 1080px) {
    .site-footer {
      padding-block: 1.875rem;
    }

    .site-footer__inner {
      grid-template-columns: 1fr auto 1fr;
    }

    .site-footer__logo {
      grid-row: auto;
    }

    .site-footer__inner > :last-child {
      justify-self: end;
    }
  }
</style>
