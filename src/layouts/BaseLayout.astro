---
import type { ComponentProps } from "astro/types";
import { Font } from "astro:assets";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SEO from "../components/SEO.astro";
import ConnectWidget from "../components/ConnectWidget.astro";

type Props = ComponentProps<typeof SEO>;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO {...Astro.props} />
    <Font cssVariable="--font-archivo" preload />
    <Font
      cssVariable="--font-instrument-serif"
      preload={[{ style: "italic", subset: "latin" }]}
    />
    <Font cssVariable="--font-dm-sans" preload={[{ subset: "latin" }]} />
    <slot name="head" />
  </head>

  <body data-theme="light">
    <SiteHeader />
    <slot />
    <SiteFooter />
    <ConnectWidget />
  </body>
</html>
