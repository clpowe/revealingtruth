---
import type { ComponentProps } from "astro/types";
import { Font } from "astro:assets";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SEO from "../components/SEO.astro";
import ConnectWidget from "../components/ConnectWidget.astro";
import LiveBanner from "../components/LiveBanner.astro";

type Props = ComponentProps<typeof SEO> &
  ComponentProps<typeof SiteHeader> & {
    /** The corner Connect widget; off where the page is the form itself */
    connect?: boolean;
  };

const { position, connect = true, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO {...seoProps} />
    <Font cssVariable="--font-archivo" preload />
    <Font
      cssVariable="--font-instrument-serif"
      preload={[{ style: "italic", subset: "latin" }]}
    />
    <Font cssVariable="--font-dm-sans" preload={[{ subset: "latin" }]} />
    <slot name="head" />
  </head>

  <body data-theme="light">
    {/* The banner refreshes status in place, including on prerendered pages. */}
    {Astro.url.pathname.replace(/\/$/, "") !== "/live" && <LiveBanner />}
    <SiteHeader position={position} />
    <slot />
    <SiteFooter />
    {connect && <ConnectWidget />}
  </body>
</html>
