# Public, build-time media origin, without a trailing slash.
# Preview: https://pub-<bucket-id>.r2.dev
# Production: https://media.<your-domain> (R2 custom domain with caching)
# Leave empty to show the existing hero image without requesting video.
PUBLIC_HERO_VIDEO_BASE_URL=https://pub-67c32fbe2c6e4b858c94913f928e6e5f.r2.dev

# PostHog public browser configuration.
# Public PostHog browser analytics configuration.
PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
PUBLIC_POSTHOG_HOST=your_posthog_host
